# Free key from https://twelvedata.com (without one, the app falls back to the public demo key: AAPL only)
TWELVE_DATA_API_KEY=
# Free key from https://console.groq.com (without one, the note is written from the numbers by code)
GROQ_API_KEY=
# Optional: which Groq model writes the note
GROQ_MODEL=llama-3.3-70b-versatile
