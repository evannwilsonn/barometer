# --- The forecast ---
# Free key from https://twelvedata.com (without one, the app falls back to the public demo key: AAPL only)
TWELVE_DATA_API_KEY=
# Free key from https://console.groq.com (without one, notes and emails are written from the numbers by code)
GROQ_API_KEY=
# Optional: which Groq model writes
GROQ_MODEL=llama-3.3-70b-versatile

# --- Accounts and the logbook (leave MONGODB_URI empty to switch them off) ---
# A free MongoDB Atlas cluster's connection string
MONGODB_URI=
# Set to false only for a standalone local mongod (Atlas supports transactions)
MONGODB_TRANSACTIONS=true
# Any long random string, e.g. the output of: openssl rand -hex 32
BETTER_AUTH_SECRET=
# This site's address
BETTER_AUTH_URL=http://localhost:3000

# --- Search and news ---
# Free key from https://finnhub.io (without one, search covers ten popular stocks and news is hidden)
FINNHUB_API_KEY=

# --- Email ---
# A Gmail address and a Gmail app password (2-step verification must be on)
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
# Or any SMTP server instead, e.g. a local mail catcher: smtp://localhost:1025
SMTP_URL=

# --- Background jobs (Inngest) ---
# Locally: INNGEST_DEV=1 and run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`
INNGEST_DEV=
# In production, from the Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
